TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_client_id

# Guild TEXT channel (not a category) for the purchase panel and ticket threads.
# On startup the bot posts or updates one panel here. Each purchase opens a
# private thread under this channel (public thread only if private threads fail).
# @mentioning a member inside that thread adds them to the ticket.
# Bot permissions in this channel: View Channel, Send Messages, Read Message History,
# Embed Links, Attach Files, Create Public Threads, Create Private Threads,
# Send Messages in Threads, Manage Threads, Manage Messages (to pin the panel).
# Customers need View Channel, Read Message History, and Send Messages in Threads
# so they can type in the ticket even if Send Messages is off on the parent channel.
# Railway: TICKET_PANEL_CHANNEL_ID=1486387508517535774
TICKET_PANEL_CHANNEL_ID=your_ticket_panel_text_channel_id

# Deprecated, ignored. Older versions created sibling text channels in this category.
# Safe to leave set on existing deploys; new tickets are threads under TICKET_PANEL_CHANNEL_ID.
TICKET_CATEGORY_ID=

# Staff role added to each private ticket thread (bots in the role are skipped).
# Also grant this role Manage Threads so staff can see private tickets if member add fails.
# Do not set this to @everyone.
STAFF_ROLE_ID=your_staff_role_id

# Daily @everyone status: set to true/1 to enable (default off)
STATUS_ENABLED=false

# Daily firmware status broadcast (text channel ID, not category)
STATUS_CHANNEL_ID=your_status_text_channel_id

# Timezone for the scheduler (IANA name). Examples: UTC, America/New_York, Asia/Shanghai
STATUS_TIMEZONE=UTC

# Post times in 24h HH:mm, comma-separated (in STATUS_TIMEZONE)
# Example once daily: 12:00
# Example twice daily: 09:00,21:00
STATUS_POST_TIMES=12:00

# Minutes after posting to delete the @everyone status message (0 = keep until next-day cleanup)
STATUS_MESSAGE_TTL_MINUTES=10

# Discount shown in daily status message
STATUS_DM_DISCOUNT=10%
